# ============================================================
# Corpus AI - Environment Variables
# ============================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# NEVER commit the .env file to git!
# ============================================================

# --- Database ---
# For local development (SQLite - zero setup):
DATABASE_URL=sqlite:///./data/corpus_ai.db
# For production (Supabase Postgres):
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# --- Redis ---
# For local development (Docker Redis):
REDIS_URL=redis://localhost:6379/0
# For production (Redis Cloud):
# REDIS_URL=redis://default:password@host:port

# --- LLM (Ollama) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# --- Embeddings ---
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- ChromaDB ---
CHROMA_PERSIST_DIR=./data/chroma

# --- JWT Authentication ---
# Generate a strong secret: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=CHANGE-ME-generate-a-real-secret-key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- File Storage ---
UPLOAD_DIR=./data/uploads

# --- Rate Limiting ---
RATE_LIMIT_PER_HOUR=20

# --- Logging ---
LOG_LEVEL=INFO

# --- App ---
APP_NAME=Corpus AI
APP_VERSION=1.0.0
API_V1_PREFIX=/api/v1
